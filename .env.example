# ==============================================================================
# Prost POS — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` or set these environment variables in your deployment.

# Application Environment: "dev" or "prod"
# In "prod", security checks are enforced (e.g. BROAST_PIN_PEPPER must not be default).
APP_ENV=prod

# Application Debug Mode: "true" or "false"
DEBUG=false

# Primary UI / system language: "ar" (default) or "en"
LANGUAGE=ar

# Secret Pepper for PIN Hashing (PBKDF2-HMAC-SHA256)
# REQUIRED in production (APP_ENV=prod).
# Generate a strong, unique secret key (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
# Keep this value secret and OUT of the database / version control.
BROAST_PIN_PEPPER=change-me-to-a-secure-random-secret-pepper-string
